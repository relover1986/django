    '<line x1="' + x1 + '" y1="' + y + '" x2="' + x2 + '" y2="' + y + '"/>' +
    '<line x1="' + x1 + '" y1="' + (y - 8) + '" x2="' + x1 + '" y2="' + (y + 8) + '"/>' +
    '<line x1="' + x2 + '" y1="' + (y - 8) + '" x2="' + x2 + '" y2="' + (y + 8) + '"/>' +
