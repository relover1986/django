function dimV(y1, y2, x, txt) {
  const my = (y1 + y2) / 2;
  const tx = x + 16;
  return '<g stroke="#3b5067" stroke-width="1.3" fill="none">' +
    '<line x1="' + x + '" y1="' + y1 + '" x2="' + x + '" y2="' + y2 + '"/>' +
    '<line x1="' + (x - 8) + '" y1="' + y1 + '" x2="' + (x + 8) + '" y2="' + y1 + '"/>' +
