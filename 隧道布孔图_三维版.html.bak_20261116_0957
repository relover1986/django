<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>隧道炮孔布置 · 三维布孔图</title>
<style>
  :root{
    --bg:#edf3f9;
    --ink:#152538;
    --muted:#72849a;
    --line:#e0e9f3;
    --blue:#1d6fe0;
    --blue-deep:#1558b4;
    --cyan:#0ea5c6;
    --orange:#e08a1e;
    --red:#cf4b47;
    --green:#159a72;
    --shadow:0 10px 28px rgba(34,72,112,.07);
    --radius:16px;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;background:var(--bg);color:var(--ink);
    font-family:"Microsoft YaHei","PingFang SC","Segoe UI",system-ui,-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased;overflow:hidden;
  }
  button,input{font:inherit}
  button{cursor:pointer;border:0;background:none;color:inherit}
  ::selection{background:#cfe6ff}
  .app{display:flex;height:100vh;min-height:680px}

  /* ================= left panel ================= */
  .panel{
    width:392px;flex:0 0 392px;min-height:0;display:flex;flex-direction:column;
    background:linear-gradient(180deg,#fcfdff 0%,#f5f9fd 100%);
    border-right:1px solid #dce6f1;
  }
  .brand{display:flex;align-items:center;gap:12px;padding:20px 22px 15px;flex:0 0 auto}
  .brand-mark{
    width:42px;height:42px;border-radius:13px;display:grid;place-items:center;color:#fff;
    background:linear-gradient(145deg,#1e74e8 0%,#0e9fbd 100%);
    box-shadow:0 9px 20px rgba(20,105,205,.24);flex:0 0 auto;
  }
  .brand-mark svg{width:23px;height:23px}
  .brand h1{font-size:16px;line-height:1.2;margin:0;letter-spacing:.3px;font-weight:700}
  .brand p{margin:4px 0 0;font-size:9.5px;color:#8798ac;letter-spacing:1.8px;font-weight:600}
  .scroll{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:0 20px 16px;scrollbar-width:thin;scrollbar-color:#cbd9e8 transparent}
  .scroll::-webkit-scrollbar{width:6px}
  .scroll::-webkit-scrollbar-thumb{background:#cbd9e8;border-radius:6px}

  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);margin-top:11px}
  .card-head{display:flex;align-items:center;justify-content:space-between;padding:13px 15px 0}
  .card-head h2{margin:0;font-size:12px;font-weight:750;letter-spacing:.3px;color:#2b4058}
  .card-head .tag{font-size:9.5px;color:#5f87aa;background:#edf6fe;border:1px solid #d9eafa;border-radius:999px;padding:3px 7px;font-weight:600}
  .card-body{padding:11px 15px 14px}

  .modes{display:flex;gap:6px;background:#f3f7fc;border:1px solid #e3ebf5;border-radius:10px;padding:3px}
  .modes button{flex:1;height:30px;border-radius:7px;font-size:10.5px;color:#5b7088;font-weight:600;transition:.15s}
  .modes button.on{background:#fff;color:#1768c6;box-shadow:0 2px 7px rgba(35,80,130,.12)}
  .modes button:hover{color:#1768c6}
  .action-row{display:flex;gap:8px;margin-top:9px}
  .btn{height:34px;border-radius:9px;border:1px solid #d7e3f0;background:#f8fbfe;color:#46617d;font-size:11px;font-weight:650;display:inline-flex;align-items:center;justify-content:center;gap:6px;transition:.15s;padding:0 10px}
  .btn:hover{border-color:#9ec5ee;background:#f1f8ff;color:#1b6bcf}
  .btn.primary{background:linear-gradient(135deg,#1e74e8,#0e9fbd);border-color:transparent;color:#fff;box-shadow:0 7px 16px rgba(25,115,210,.22);flex:1}
  .btn.primary:hover{filter:brightness(1.04);color:#fff}
  .btn.ghost{background:#fff}
  .btn:active{transform:translateY(1px)}
  .status{margin:8px 0 0;font-size:9.5px;line-height:1.5;color:#8a9cae;min-height:14px}
  .status.warn{color:#a46812}
  .status b{color:#805616}

  .stats{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:11px}
  .stats .stat:last-child:nth-child(5){grid-column:1/-1}
  .stat{background:#fff;border:1px solid var(--line);border-radius:13px;padding:11px 12px;box-shadow:0 4px 14px rgba(35,72,110,.035)}
  .stat>span{display:block;font-size:9.5px;color:#8294a8;letter-spacing:.3px}
  .stat-row{display:flex;align-items:baseline;gap:4px;margin-top:4px}
  .stat b{font-size:21px;line-height:1;font-weight:750;letter-spacing:-.6px;font-variant-numeric:tabular-nums;color:#1b3048}
  .stat i{font-style:normal;font-size:9.5px;color:#91a1b4;white-space:nowrap}
  .stat small{display:block;margin-top:3px;font-size:8.5px;color:#a1b0c1}

  .field{margin-bottom:10px}
  .field:last-child{margin-bottom:0}
  .field label{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10.5px;color:#4a5e75;margin-bottom:5px;font-weight:600}
  .field label .tag{font-size:8.5px;color:#7b8fa5;font-weight:500;background:#f1f5fa;border-radius:4px;padding:2px 5px}
  .input-wrap{display:flex;align-items:center;border:1px solid #d5e1ee;border-radius:9px;background:#f9fbfd;overflow:hidden;transition:.15s}
  .input-wrap:focus-within{border-color:#3f8be4;background:#fff;box-shadow:0 0 0 3px rgba(45,124,225,.1)}
  .input-wrap input{border:0;outline:none;background:transparent;width:100%;padding:7px 9px;font-size:13px;font-weight:700;color:#18314d;font-variant-numeric:tabular-nums;letter-spacing:.2px}
  .input-wrap .unit{padding:0 9px;font-size:9.5px;color:#8fa0b3;border-left:1px solid #e5edf5;line-height:26px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  .const-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .const-grid>div{background:#f7fafd;border:1px solid #e6eef7;border-radius:9px;padding:8px 10px;display:flex;align-items:baseline;gap:5px;flex-wrap:wrap}
  .const-grid span{width:100%;font-size:9px;color:#8294a8}
  .const-grid b{font-size:18px;line-height:1;color:#1b3b5c;font-variant-numeric:tabular-nums}
  .const-grid i{font-style:normal;font-size:8.5px;color:#8fa0b3}
  .count-result{
    margin-top:2px;padding:8px 10px;border-radius:9px;background:#f2f8ff;
    border:1px solid #dbe9f7;display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;
  }
  .count-result span{font-size:9.5px;color:#6f869b}
  .count-result b{font-size:20px;line-height:1;color:#1768c6;font-variant-numeric:tabular-nums}
  .count-result small{width:100%;font-size:8.5px;color:#8b9cae}
  .hint{margin:6px 0 0;font-size:9px;line-height:1.5;color:#8c9caf}

  .sel-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  .inline-actions{display:flex;align-items:center;gap:8px;margin-top:9px}
  .inline-actions .btn{flex:1;height:30px;font-size:10.5px}
  .check{display:flex;align-items:center;gap:5px;font-size:10px;color:#5d7288;white-space:nowrap;cursor:pointer}
  .check input{accent-color:#1d6fe0;width:13px;height:13px}

  .switch-row{display:flex;align-items:center;justify-content:space-between;padding:5px 0;font-size:10.5px;color:#50657c}
  .switch{position:relative;display:inline-block;width:30px;height:17px;flex:0 0 auto}
  .switch input{opacity:0;width:0;height:0;position:absolute}
  .switch span{position:absolute;inset:0;background:#d6e2ee;border-radius:999px;transition:.18s}
  .switch span::before{content:"";position:absolute;width:13px;height:13px;left:2px;top:2px;background:#fff;border-radius:50%;box-shadow:0 1px 3px rgba(20,40,60,.2);transition:.18s}
  .switch input:checked+span{background:#1d6fe0}
  .switch input:checked+span::before{transform:translateX(13px)}

  .title-input,.title-select{width:100%;border:1px solid #d5e1ee;border-radius:9px;background:#f9fbfd;padding:7px 9px;font-size:10.5px;color:#334a62;outline:none;margin-top:4px}
  .title-input:focus,.title-select:focus{border-color:#3f8be4;background:#fff;box-shadow:0 0 0 3px rgba(45,124,225,.1)}
  .export-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
  .export-grid .btn{height:31px;font-size:10px}

  .notes{font-size:9px;line-height:1.65;color:#8b9aac;padding:2px 3px 0;margin:11px 0 0}
  .notes b{color:#60758b}
  .panel-footer{flex:0 0 auto;display:flex;align-items:center;gap:6px;padding:9px 20px;border-top:1px solid #e2eaf3;color:#8b9cae;font-size:9px;background:#fbfdff}
  .panel-footer svg{width:11px;height:11px;flex:0 0 auto}
  .panel-footer .sep{margin-left:auto;color:#b0bdcb}

  /* ================= stage ================= */
  .right-col{flex:1;min-width:0;display:flex;flex-direction:column;gap:12px;margin:14px 14px 14px 0;overflow-y:auto;padding-bottom:6px}
  .right-col .stage{flex:0 0 auto;width:100%;height:64vh;min-height:480px;margin:0}
  .stage{
    position:relative;flex:1;min-width:0;margin:14px 14px 14px 0;border-radius:22px;overflow:hidden;
    background:#071321;box-shadow:0 24px 60px rgba(18,48,80,.2);isolation:isolate;transition:background .25s;
  }
  .seq-panel{flex:0 0 auto;background:#fff;border-radius:18px;box-shadow:0 16px 40px rgba(33,67,105,.13);padding:13px 18px 10px;color:#20364d}
  .seq-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:4px}
  .seq-head h2{margin:0;font-size:13px;letter-spacing:.2px;color:#18324b}
  .seq-head p{margin:2px 0 0;font-size:10px;color:#8a9bad}
  .seq-badge{font-size:11px;font-weight:800;color:#1d6fe0;background:#eef5ff;border-radius:999px;padding:4px 9px;white-space:nowrap}
  #cvSeq{width:100%;height:365px;display:block;background:#fff;border-radius:12px}
  .seq-body{display:flex;gap:14px;align-items:stretch}
  .seq-body #cvSeq{flex:1 1 auto;min-width:0}
  .seq-side{flex:0 0 auto;width:148px;display:flex;flex-direction:column;justify-content:center;padding:4px 0 6px}
  .seq-side-title{font-size:17px;font-weight:800;color:#18324b;margin-bottom:9px;letter-spacing:.5px}
  .seq-legend{display:flex;flex-direction:column;gap:9px;font-size:17px;color:#20364d}
  .seq-legend span{display:flex;align-items:center;gap:7px;white-space:nowrap}
  .seq-legend i{width:9px;height:9px;border-radius:50%;display:block;flex:0 0 auto}
  .seq-legend em{font-style:normal;color:#5b7286;margin-left:1px}
  .seq-legend .s1{background:#e74c3c}.seq-legend .s2{background:#e67e22}.seq-legend .s3{background:#e0b400}.seq-legend .s4{background:#27ae60}
  .seq-legend .s5{background:#2f80ed}.seq-legend .s6{background:#8e44ad}.seq-legend .s7{background:#16a085}.seq-legend .s8{background:#d81b60}
  #scene3d{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;touch-action:none;outline:none}
  #scene3d.dragging{cursor:grabbing}
  .paper{position:absolute;inset:0;display:none;padding:64px 18px 16px;background:linear-gradient(180deg,#eef3f9,#e7eef6)}
  .paper svg{width:100%;height:100%;display:block;background:#fff;border-radius:14px;box-shadow:0 16px 40px rgba(33,67,105,.13);touch-action:none}
  #cv .hole{cursor:grab}
  #cv .hole:active{cursor:grabbing}
  #cv.add-mode .hole{cursor:crosshair}

  .stage-head{position:absolute;left:28px;top:20px;z-index:4;pointer-events:none;color:#fff;max-width:46%}
  .eyebrow{font-size:9px;letter-spacing:2.6px;color:#58b3d8;font-weight:800}
  .stage-head h1{margin:6px 0 3px;font-size:21px;line-height:1.2;font-weight:650;letter-spacing:.2px;text-shadow:0 2px 24px rgba(0,0,0,.35)}
  .stage-head p{margin:0;font-size:10.5px;color:#8fa8bd;font-variant-numeric:tabular-nums;letter-spacing:.2px}

  .tabbar{
    position:absolute;left:50%;top:18px;transform:translateX(-50%);z-index:7;display:flex;gap:3px;
    background:rgba(11,30,50,.72);border:1px solid rgba(255,255,255,.11);border-radius:11px;padding:3px;
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  }
  .tabbar button{height:29px;padding:0 14px;border-radius:8px;font-size:10.5px;font-weight:650;color:#9fb9ce;transition:.16s}
  .tabbar button:hover{color:#fff}
  .tabbar button.active{background:rgba(48,120,180,.85);color:#fff;box-shadow:0 3px 10px rgba(0,0,0,.2)}

  .tools{position:absolute;right:19px;top:17px;z-index:8;display:flex;gap:6px}
  .tool{
    height:34px;min-width:34px;padding:0 9px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;gap:5px;
    border:1px solid rgba(255,255,255,.12);background:rgba(14,34,55,.64);color:#c9ddee;
    backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-size:10px;transition:.15s;
  }
  .tool:hover{background:rgba(34,84,124,.76);border-color:rgba(120,190,240,.38);color:#fff}
  .tool:active{transform:translateY(1px)}
  .tool svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .tool .label{white-space:nowrap}

  .hud{
    position:absolute;right:20px;bottom:20px;z-index:5;width:232px;padding:13px 15px 12px;border-radius:15px;
    background:linear-gradient(145deg,rgba(13,37,60,.9),rgba(9,25,42,.8));
    border:1px solid rgba(92,174,220,.23);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    color:#eaf4ff;box-shadow:0 16px 38px rgba(0,0,0,.26);
  }
  .hud-label{font-size:9px;letter-spacing:1.6px;color:#7da8c6;font-weight:700}
  .hud-value{display:flex;align-items:baseline;gap:5px;margin:5px 0 2px}
  .hud-value b{font-size:31px;line-height:1.05;letter-spacing:-1px;font-variant-numeric:tabular-nums;color:#7fe0ff;font-weight:750}
  .hud-value span{font-size:10px;color:#8db2c9}
  .hud-value em{font-style:normal;font-size:11px;color:#8db2c9;margin-left:3px}
  .hud-sub{font-size:9.5px;color:#9db8cb;line-height:1.5}
  .hud-sub b{color:#e6f3ff;font-weight:650}
  .hud-line{height:1px;background:rgba(255,255,255,.1);margin:9px 0 7px}
  .hud-meta{display:flex;justify-content:space-between;gap:8px;font-size:9.5px;color:#91aec2;margin-top:3px}
  .hud-meta b{color:#d8e9f7;font-weight:650;font-variant-numeric:tabular-nums}

  .legend{
    position:absolute;left:22px;bottom:20px;z-index:5;padding:10px 12px;border-radius:11px;
    background:rgba(9,26,43,.68);border:1px solid rgba(255,255,255,.09);
    backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#bcd4e6;display:flex;gap:13px;align-items:center;
  }
  .lg{display:flex;align-items:center;gap:5px;font-size:9px;white-space:nowrap}
  .lg i{width:7px;height:7px;border-radius:50%;display:block;box-shadow:0 0 0 3px rgba(255,255,255,.04)}
  .lg.per i{background:#ffb454}
  .lg.floor i{background:#4fd39b}
  .lg.under i{background:#a78bfa}
  .lg.int i{background:#5fd0ff}
  .lg.cut i{background:#f472d0}
  .lg.sel i{background:#ff5c52}

  .hintbar{
    position:absolute;left:50%;bottom:18px;transform:translateX(-50%);z-index:5;
    font-size:9.5px;color:#6e8ba2;white-space:nowrap;letter-spacing:.4px;pointer-events:none;
  }
  .tooltip{
    position:absolute;z-index:20;pointer-events:none;padding:7px 9px;border-radius:8px;
    background:rgba(5,17,30,.95);border:1px solid rgba(110,200,240,.26);
    box-shadow:0 10px 26px rgba(0,0,0,.35);color:#eaf6ff;font-size:9.5px;line-height:1.55;
    opacity:0;transform:translateY(3px);transition:opacity .12s,transform .12s;white-space:nowrap;
  }
  .tooltip.show{opacity:1;transform:translateY(0)}
  .tooltip b{display:block;font-size:10.5px;color:#fff;margin-bottom:1px}
  .tooltip span{display:block;color:#94b9cf}
  .tooltip i{font-style:normal;color:#e8f4ff;font-variant-numeric:tabular-nums}

  .toast{
    position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(10px);z-index:60;
    padding:9px 15px;border-radius:9px;background:#12283d;border:1px solid rgba(110,200,240,.3);
    color:#dcefff;font-size:10.5px;box-shadow:0 14px 34px rgba(0,0,0,.3);opacity:0;pointer-events:none;
    transition:opacity .22s,transform .22s;max-width:70vw;text-align:center;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  .toast.err{background:#4a1719;border-color:#9d3b3e;color:#ffe4e3}
  .debug{display:none}

  /* 2D 模式 */
  .stage.mode2d{background:#e9eff6;box-shadow:0 24px 60px rgba(18,48,80,.12)}
  .stage.mode2d #scene3d{display:none}
  .stage.mode2d .paper{display:block}
  .stage.mode2d .stage-head,.stage.mode2d .hud,.stage.mode2d .legend{display:none}
  .stage.mode2d .tabbar{background:rgba(255,255,255,.9);border-color:#d6e2ef;box-shadow:0 8px 20px rgba(30,65,100,.1)}
  .stage.mode2d .tabbar button{color:#617890}
  .stage.mode2d .tabbar button.active{background:#1d6fe0;color:#fff}
  .stage.mode2d .tool{background:rgba(255,255,255,.9);border-color:#d6e2ef;color:#42617f;box-shadow:0 8px 20px rgba(30,65,100,.08)}
  .stage.mode2d .tool:hover{background:#fff;border-color:#9ec5ee;color:#1768c6}
  .stage.mode2d .tool.view3d{display:none}
  .stage.mode2d .hintbar{color:#637b93}

  @media (max-width:1180px){
    .panel{width:360px;flex-basis:360px}
    .stage-head{max-width:38%}
    .stage-head h1{font-size:19px}
    .hud{width:210px}
    .tabbar{left:auto;right:168px;transform:none}
    .tools{top:62px}
  }
  @media (max-width:980px){
    body{overflow:auto}
    .app{height:auto;min-height:100vh;flex-direction:column}
    .panel{width:100%;flex:0 0 auto;border-right:0;border-bottom:1px solid #dce6f1}
    .scroll{overflow:visible;max-height:none}
    .stage{height:72vh;min-height:520px;margin:0 10px 10px}
    .panel-footer{position:static}
  }
  @media (max-width:640px){
    .brand{padding:16px 16px 12px}
    .scroll{padding:0 14px 14px}
    .stage{height:70vh;min-height:460px;margin:0 8px 8px;border-radius:16px}
    .stage-head{left:18px;top:14px;max-width:54%}
    .stage-head h1{font-size:16px}
    .stage-head p{font-size:9px}
    .tabbar{top:10px;left:auto;right:12px;transform:none}
    .tabbar button{height:28px;padding:0 10px;font-size:9.5px}
    .tools{top:56px;right:12px}
    .tool{height:31px;min-width:31px;padding:0 7px}
    .tool .label{display:none}
    .hud{right:12px;bottom:12px;width:144px;padding:8px 10px}
    .hud-value b{font-size:22px}
    .hud-sub{font-size:8.5px}
    .hud-line{margin:7px 0 5px}
    .hud-meta:last-child{display:none}
    .legend{display:none}
    .hintbar{display:none}
    .seq-body{flex-direction:column;gap:8px}
    .seq-side{width:100%;flex-direction:row;align-items:center;gap:12px;padding:0}
    .seq-side-title{font-size:14px;margin-bottom:0;white-space:nowrap}
    .seq-legend{flex-direction:row;flex-wrap:wrap;gap:4px 14px;font-size:14px}
    .paper{padding:52px 8px 8px}
  }
  @media (max-width:400px){
    .hud{width:136px}
    .hud-value b{font-size:20px}
  }
</style>
</head>
<body>
<div class="app">
  <aside class="panel">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20V9a8 8 0 0 1 16 0v11"/>
          <path d="M2 20h20M8 20V9a4 4 0 0 1 8 0v11"/>
          <path d="M6 13h2M16 13h2M10 20v-3M14 20v-3"/>
        </svg>
      </div>
      <div>
        <h1>隧道炮孔布置</h1>
        <p>TUNNEL BLAST · 3D</p>
      </div>
    </div>

    <div class="scroll">
      <section class="card" style="margin-top:2px">
        <div class="card-head"><h2>显示与导出</h2><span class="tag">本地保存</span></div>
        <div class="card-body">
          <div class="field">
            <label for="fGrade">围岩级别 / 图名</label>
            <select class="title-select" id="fGrade" aria-label="围岩级别图名">
