/* ============================================================
   断面几何
   ============================================================ */
function geom() {
  const W = Math.max(100, Number(S.W) || 100);
  const H = Math.max(100, Number(S.H) || 100);
  const rise = clamp(Number(S.rise) || 100, 10, H - 10);
  const wall = H - rise;
  const R = (Math.pow(W / 2, 2) + rise * rise) / (2 * rise);
  const cy = wall + rise - R;
  return { W, H, rise, wall, R, cy };
}

function archAngles(g) {
  return [
    Math.atan2(g.wall - g.cy, -g.W / 2),
    Math.atan2(g.wall - g.cy, g.W / 2)
  ];
}

function archPoints(g, n) {
  const a = archAngles(g);
  const pts = [];
  for (let i = 0; i <= n; i++) {
    const t = a[0] + (a[1] - a[0]) * i / n;
    pts.push([g.W / 2 + g.R * Math.cos(t), g.cy + g.R * Math.sin(t)]);
  }
  return pts;
}

function outline(g) {
  const a = archAngles(g);
  const arcLen = g.R * Math.abs(a[1] - a[0]);
  const n = Math.max(10, Math.round(arcLen / 5));
  const pts = [[0, 0], [0, g.wall]];
  const ap = archPoints(g, n);
  for (let i = 1; i < ap.length - 1; i++) pts.push(ap[i]);
  const nw = clamp(Number(S.notchW) || 0, 0, g.W - 40);
  const nh = clamp(Number(S.notchH) || 0, 0, g.wall - 10);
  if (nw > 0 && nh > 0) {
    // 右下角凹槽：从底板标高向下 50，宽度从右墙向左 55
    pts.push([g.W, g.wall], [g.W, 0], [g.W, -nh], [g.W - nw, -nh], [g.W - nw, 0]);
  } else {
    pts.push([g.W, g.wall], [g.W, 0]);
  }
  return pts;
}

function segDist(pt, a, b) {
  const vx = b[0] - a[0], vy = b[1] - a[1];
  const wx = pt[0] - a[0], wy = pt[1] - a[1];
  const L = vx * vx + vy * vy;
  const t = L > 0 ? clamp((wx * vx + wy * vy) / L, 0, 1) : 0;
  return Math.hypot(pt[0] - (a[0] + t * vx), pt[1] - (a[1] + t * vy));
}

function distOutline(pt, poly) {
  let d = Infinity;
  for (let i = 0; i < poly.length; i++) {
    d = Math.min(d, segDist(pt, poly[i], poly[(i + 1) % poly.length]));
  }
  return d;
}

function insidePoly(pt, poly) {
  let inside = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const a = poly[i], b = poly[j];
    if (((a[1] > pt[1]) !== (b[1] > pt[1])) &&
        (pt[0] < (b[0] - a[0]) * (pt[1] - a[1]) / (b[1] - a[1]) + a[0])) {
      inside = !inside;
    }
  }
  return inside;
}

function insideOrEdge(pt, poly) {
  return insidePoly(pt, poly) || distOutline(pt, poly) < 0.6;
}

function polyArea(poly) {
  let s = 0;
  for (let i = 0; i < poly.length; i++) {
    const a = poly[i], b = poly[(i + 1) % poly.length];
    s += a[0] * b[1] - b[0] * a[1];
  }
  return Math.abs(s / 2);
}

function polyLength(poly) {
  let s = 0;
  for (let i = 0; i < poly.length; i++) {
    const a = poly[i], b = poly[(i + 1) % poly.length];
    s += Math.hypot(b[0] - a[0], b[1] - a[1]);
  }
  return s;
}

/* ============================================================
   自动布孔
   ============================================================ */
function wallArchPoints(g, count) {
  // 墙孔按图纸固定间距：左墙从 60 起、右墙从 50 起，间距 60
  const leftStart = clamp(Number(S.wallStartLeft) || 60, 0, g.wall);
  const rightStart = clamp(Number(S.wallStartRight) || 50, 0, g.wall);
  const spacing = Math.max(20, Number(S.wallSpacing) || 60);
  const left = [];
  for (let y = leftStart; y <= g.wall + 1e-6; y += spacing) left.push([0, y]);
  const right = [];
  for (let y = rightStart; y <= g.wall + 1e-6; y += spacing) right.push([g.W, y]);

  // 剩余的周边孔个数分配给拱圈；拱圈包含左右拱脚两个端点
  const archN = Math.max(2, Math.round(count) - left.length - right.length);
  const a = archAngles(g);
  const arch = [];
  for (let i = 0; i < archN; i++) {
    const t = a[0] + (a[1] - a[0]) * i / (archN - 1);
    arch.push([g.W / 2 + g.R * Math.cos(t), g.cy + g.R * Math.sin(t)]);
  }
  right.reverse(); // 沿拱圈到右墙后，自上而下编号
  return left.concat(arch, right);
}

function blockCorners(g) {
  const nw = clamp(Number(S.notchW) || 0, 0, g.W - 40);
  const nh = clamp(Number(S.notchH) || 0, 0, g.wall - 10);
  if (nw <= 0 || nh <= 0) return [];
  // 55×50 向下多出块的四角（含地下两个角点）
  return [
    [g.W - nw, 0],
    [g.W, 0],
    [g.W - nw, -nh],
    [g.W, -nh]
  ];
}

function cutLayout(g, count) {
  const n = clamp(Math.round(Number(count) || 0), 0, 200);
  if (!n) return [];
  const cx = g.W / 2, cy = 300;
  const ring = [
    // 左侧 1 列 4 孔 + 右侧 1 列 4 孔，关于中线镜像对称
    [cx - 60, cy - 60], [cx - 60, cy - 20], [cx - 60, cy + 20], [cx - 60, cy + 60],
    [cx + 60, cy - 60], [cx + 60, cy - 20], [cx + 60, cy + 20], [cx + 60, cy + 60]
  ];
  if (n <= 8) return ring.slice(0, n);
  const pts = ring.slice();
  pts.push([cx, cy]);
  const cand = [];
  for (let x = cx - 150; x <= cx + 150; x += 30) {
    for (let y = 150; y <= 390; y += 30) {
      const p = [x, y];
      if (insideOrEdge(p, outline(g)) && distOutline(p, outline(g)) > 28) cand.push(p);
    }
  }
  while (pts.length < n && cand.length) {
    let bi = 0, bd = -1;
    for (let i = 0; i < cand.length; i++) {
      let dmin = Infinity;
      for (const q of pts) dmin = Math.min(dmin, Math.hypot(cand[i][0] - q[0], cand[i][1] - q[1]));
      if (dmin > bd) { bd = dmin; bi = i; }
    }
    pts.push(cand.splice(bi, 1)[0]);
  }
  return pts;
}

function seqAuxLayout(g, count) {
  const n = clamp(Math.round(Number(count) || 0), 0, 2000);
  if (!n) return [];
  const weights = [1.08, 1.0, 0.9, 0.76];
  const rowCount = Math.min(8, Math.max(0, Math.round(n * 0.06)));
  const ringTotal = Math.max(0, n - rowCount);
  const wsum = weights.reduce((a, b) => a + b, 0);
  const counts = weights.map(w => Math.floor(ringTotal * w / wsum));
  let left = ringTotal - counts.reduce((a, b) => a + b, 0);
  for (let i = 0; left > 0; i = (i + 1) % 4, left--) counts[i]++;

  const pts = [];
  const rings = [55, 110, 165, 220];
  rings.forEach((d, ri) => {
    const Rr = g.R - d;
    const half = g.W / 2 - d;
    const ys = g.cy + Math.sqrt(Math.max(0, Rr * Rr - half * half));
    const a0 = Math.atan2(ys - g.cy, -half);
    const a1 = Math.atan2(ys - g.cy, half);
    const path = [[d, 0], [d, ys]];
    for (let i = 0; i <= 60; i++) {
      const a = a0 + (a1 - a0) * i / 60;
      path.push([g.W / 2 + Rr * Math.cos(a), g.cy + Rr * Math.sin(a)]);
    }
    path.push([g.W - d, 0]);
    const segs = [];
    let total = 0;
    for (let i = 1; i < path.length; i++) {
      const len = Math.hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);
      segs.push(len); total += len;
    }
    for (let k = 0; k < counts[ri]; k++) {
      let t = total * (k + 0.5) / counts[ri], si = 0;
      while (si < segs.length - 1 && t > segs[si]) { t -= segs[si]; si++; }
      const a = path[si], b = path[si + 1];
      const u = segs[si] ? t / segs[si] : 0;
      pts.push([a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u]);
    }
  });
  const x0 = 115, x1 = g.W - 70;
  for (let k = 0; k < rowCount; k++) {
    pts.push([x0 + (x1 - x0) * (k + 0.5) / rowCount, 50]);
  }
  return pts.filter(p => insideOrEdge(p, outline(g)) && distOutline(p, outline(g)) > 18);
}

function perimeter(g) {
  const hs = wallArchPoints(g, Number(S.perCount) || 25);
  const insetL = clamp(Number(S.floorInsetLeft) || 100, 0, g.W / 2);
  const nw = clamp(Number(S.notchW) || 0, 0, g.W - 40);
  // 普通底板孔布置在多出块左侧，多出块四角另用 4 个固定角孔
  const floorEnd = Math.max(insetL + 20, g.W - nw - 55);
  // 底板孔输入值 = 底板线上的绿色孔总数；固定点 x=0、x=W-55、x=W
  const totalFloor = clamp(Math.round(Number(S.floorCount) || 0), 3, 500);
  const endX = g.W - clamp(Number(S.notchW) || 0, 0, g.W - 40);
  const n = Math.max(0, totalFloor - 3);
  if (n === 1) {
    hs.push([endX / 2, 0]);
  } else if (n > 1) {
    for (let i = 1; i <= n; i++) {
      hs.push([endX * i / (n + 1), 0]);
    }
  }
  return hs;
}

function candidates(step) {
  const g = geom(), poly = outline(g);
  const margin = 50;
  const nx = Math.floor((g.W - 2 * margin) / step) + 1;
  if (nx < 1) return [];
  const x0 = (g.W - (nx - 1) * step) / 2;
  const ny = Math.floor((g.H - 2 * margin) / step) + 1;
  const pts = [];
  for (let j = 0; j < ny; j++) {
    for (let i = 0; i < nx; i++) {
      const p = [x0 + i * step, margin + j * step];
      if (distOutline(p, poly) >= margin && insidePoly(p, poly)) pts.push(p);
    }
  }
  return pts;
}

function pickInterior(per, needed) {
  let step = Math.max(20, Number(S.int) || 80);
  let cand = candidates(step);
  while (cand.length < needed && step > 24) {
    step -= 2;
    cand = candidates(step);
  }
  if (cand.length <= needed) return cand.slice();

  const chosen = [];
  const used = new Set();
  const base = per.slice();
  while (chosen.length < needed) {
    let best = -1, bestD = -1;
    for (let i = 0; i < cand.length; i++) {
      if (used.has(i)) continue;
      let dmin = Infinity;
      for (const b of base) {
        const d = Math.hypot(cand[i][0] - b[0], cand[i][1] - b[1]);
        if (d < dmin) dmin = d;
      }
      if (dmin > bestD) { bestD = dmin; best = i; }
    }
    if (best < 0) break;
    used.add(best);
    chosen.push(cand[best]);
    base.push(cand[best]);
  }
  return chosen;
}

function declaredCount() {
  const under = blockCorners(geom()).filter(p => p[1] < -0.5).length;
  return Math.max(0, Math.round(Number(S.perCount) || 0)) +
    Math.max(0, Math.round(Number(S.auxCount) || 0)) +
    Math.max(0, Math.round(Number(S.cutCount) || 0)) +
    Math.max(3, Math.round(Number(S.floorCount) || 0)) + under;
}

function auxLayout(per, needed) {
  if (needed <= 0) return [];
  const g = geom();
  const poly = outline(g);
  const sx = g.W / DEF.W, sy = g.H / DEF.H;
  const pool = [];
  for (const [x, y] of AUX_PATTERN) {
    const p = [x * sx, y * sy];
    if (insideOrEdge(p, poly) && distOutline(p, poly) > 22) {
      if (!pool.some(q => Math.hypot(q[0] - p[0], q[1] - p[1]) < 6)) pool.push(p);
    }
  }
  if (needed === pool.length) return pool.slice();
  if (needed < pool.length) {
    // 从图纸点位中均匀抽稀
    const chosen = [], base = per.slice();
    const rest = pool.slice();
    while (chosen.length < needed && rest.length) {
      let bi = 0, bd = -1;
      for (let i = 0; i < rest.length; i++) {
        let dmin = Infinity;
        for (const b of base) dmin = Math.min(dmin, Math.hypot(rest[i][0] - b[0], rest[i][1] - b[1]));
        if (dmin > bd) { bd = dmin; bi = i; }
      }
      const p = rest.splice(bi, 1)[0];
      chosen.push(p);
      base.push(p);
    }
    return chosen;
  }
  // 超过图纸点位数量时，用 60cm 网格补足
  const result = pool.slice();
  const base = per.concat(pool);
  let step = 60;
  const cand = [];
  for (let x = 60; x <= g.W - 60; x += step) {
    for (let y = 50; y <= g.H - 60; y += step) {
      const p = [x, y];
      if (insideOrEdge(p, poly) && distOutline(p, poly) > 50) cand.push(p);
    }
  }
  while (result.length < needed && cand.length) {
    let bi = 0, bd = -1;
    for (let i = 0; i < cand.length; i++) {
      let dmin = Infinity;
      for (const b of base) dmin = Math.min(dmin, Math.hypot(cand[i][0] - b[0], cand[i][1] - b[1]));
      if (dmin > bd) { bd = dmin; bi = i; }
    }
    const p = cand.splice(bi, 1)[0];
    result.push(p);
    base.push(p);
  }
  return result;
}

function autoLayout() {
  const g = geom();
  const per = perimeter(g);
  const auxNeeded = clamp(Math.round(Number(S.auxCount) || 0), 0, 2000);
  const cutNeeded = clamp(Math.round(Number(S.cutCount) || 0), 0, 200);
  const cut = cutLayout(g, cutNeeded).map(p => [+p[0].toFixed(2), +p[1].toFixed(2), "cut"]);
  const interior = auxLayout(per.concat(cut), auxNeeded);
  const nw = clamp(Number(S.notchW) || 0, 0, g.W - 40);
  const fixed = [
    [0, 0, "ffloor"],
    [g.W - nw, 0, "ffloor"],
    [g.W, 0, "ffloor"]
  ];
  for (const p of blockCorners(g)) {
    if (p[1] < -0.5) fixed.push([p[0], p[1], "under"]);
  }
  holes = per.concat(interior, cut, fixed).map(p => [+p[0].toFixed(2), +p[1].toFixed(2), p[2] ? p[2] : undefined]);
  // 去掉映射产生的 undefined 第三项，保持普通孔为二元数组
  holes = holes.map(p => p[2] ? p : [p[0], p[1]]);
  selected = -1;
  dirty = false;
  refreshAll();
  const target = declaredCount();
  if (holes.length !== target) {
    toast("辅助孔最多布置 " + interior.length + " 个（目标 " + auxNeeded +
      " 个），合计 " + holes.length + " 孔；请减小辅助孔个数或调整断面。", true);
    return false;
  }
  return true;
}

function holeType(h, poly) {
  return distOutline(h, poly) < 2.2 ? "perimeter" : "interior";
}

function holeKind(h, poly) {
  if (h[2] === "cut") return "cut";
  if (h[2] === "ffloor") return "floor";
  if (h[2] === "under") return "under";
  if (h[1] <= 0.5) return "floor";
  return holeType(h, poly) === "perimeter" ? "perimeter" : "aux";
}

/* ============================================================
   统计
   ============================================================ */
function computeStats() {
  const g = geom();
  const poly = outline(g);
  let per = 0, int = 0, cut = 0, floor = 0, wallArch = 0, floorFixed = 0, under = 0;
  for (const h of holes) {
    if (h[2] === "cut") {
      cut++;
    } else if (h[2] === "ffloor") {
      floorFixed++;
      floor++;
    } else if (h[2] === "under") {
      under++;
    } else if (h[1] <= 0.5) {
      floor++;
    } else if (holeType(h, poly) === "perimeter") {
      wallArch++;
    } else {
      int++;
    }
  }
  per = wallArch;
  return {
    count: holes.length,
    target: declaredCount(),
    per, int, cut,
    floor,
    floorRegular: floor - floorFixed,
    floorFixed,
    under,
    block: floorFixed + under,
    wallArch,
    area: polyArea(poly) / 10000,
    perimeter: polyLength(poly) / 100,
    wall: g.wall,
    rise: g.rise,
    R: g.R,
    W: g.W,
    H: g.H
  };
}

function updatePanelStats() {
  const st = computeStats();
  el.statCount.textContent = st.count;
  el.statTarget.textContent = "合计 " + st.target + " 孔";
  el.statArea.textContent = fmt(st.area, 1);
  el.statPerimeter.textContent = "周长 " + fmt(st.perimeter, 1) + " m";
  el.statPer.textContent = st.per;
  el.statPerNote.textContent = "墙拱 " + st.wallArch + " · 底板 " + st.floor + "（底板下 " + st.under + "）";
  el.statInt.textContent = st.int;
  el.statCut.textContent = st.cut;
  el.calcTotal.textContent = st.target;
  el.calcBreak.textContent = "墙拱 " + Math.round(Number(S.perCount) || 0) +
    " + 辅助 " + Math.round(Number(S.auxCount) || 0) +
    " + 掏槽 " + Math.round(Number(S.cutCount) || 0) +
    " + 底板 " + Math.round(Number(S.floorCount) || 0) +
    " + 底板下 " + st.under;

  el.hudCount.textContent = st.count;
  el.hudTarget.textContent = "/ " + st.target;
  el.hudPer.textContent = st.per;
  el.hudInt.textContent = st.int;
  el.hudArea.textContent = fmt(st.area, 1) + " m²";
  el.hudSize.textContent = st.W + " × " + st.H + " cm";
  el.stageSub.textContent = st.W + " × " + st.H + " cm · 拱高 " + st.rise + " cm · " + st.count + " 孔";

  const mismatch = st.count !== st.target;
  el.statusTag.textContent = (mismatch || dirty) ? "需重算" : "已布孔";
  el.statusTag.style.color = (mismatch || dirty) ? "#a46812" : "#5f87aa";
  el.statusTag.style.background = (mismatch || dirty) ? "#fff8e8" : "#edf6fe";
  el.statusTag.style.borderColor = (mismatch || dirty) ? "#f0d8a8" : "#d9eafa";

  let msg = "布孔完成，可直接在 2D 视图中拖动微调。";
  if (mismatch) {
    msg = "实际 " + st.count + " 孔，计算目标 " + st.target + " 孔；辅助孔受断面/间距限制，请减小辅助孔个数。";
  } else if (dirty) {
    msg = "参数已修改，正在按新的周边/辅助/底板孔个数重排。";
  }
  el.dirtyMsg.textContent = msg;
  el.dirtyMsg.classList.toggle("warn", mismatch || dirty);

  if (selected >= 0 && holes[selected]) {
    el.selTag.textContent = "孔 #" + (selected + 1);
    el.fX.disabled = el.fY.disabled = false;
    el.fX.value = holes[selected][0].toFixed(1);
    el.fY.value = holes[selected][1].toFixed(1);
  } else {
    el.selTag.textContent = "未选择";
    el.fX.disabled = el.fY.disabled = true;
    el.fX.value = el.fY.value = "";
  }

  el.debug.textContent = JSON.stringify({
    count: st.count, target: st.target, area: +st.area.toFixed(2),
    wall: +st.wall.toFixed(1), rise: st.rise, R: +st.R.toFixed(1),
    perimeter: +st.perimeter.toFixed(2)
  });
  stage.dataset.count = String(st.count);
  stage.dataset.area = st.area.toFixed(2);
}

